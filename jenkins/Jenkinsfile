pipeline {
    // Все стадии выполняются в Docker-контейнере с Python
    agent {
        docker { image 'python:3.13.7-alpine3.22' }
    }

    options {
        // Если статус сборки станет UNSTABLE, последующие этапы будут пропущены
        skipStagesAfterUnstable()
    }

    stages {
        stage('Setup') {
            steps {
                // Виртуальное окружение и установка зависимостей из requirements.txt
                sh '''
                python -m venv venv
                . venv/bin/activate
                pip install -r requirements.txt
                '''
            }
        }

        stage('Build') {
            steps {
                // Компиляция приложения и библиотеки calc в байт-код (.pyc)
                sh '''
                . venv/bin/activate
                python -m py_compile sources/add2vals.py sources/calc.py
                '''
                // Сохраняем исходники и байт-код для следующих этапов
                stash(name: 'compiled-results', includes: 'sources/*.py*')
            }
        }

        stage('Test') {
            steps {
                // Модульные тесты с отчётом в формате JUnit XML
                sh '''
                . venv/bin/activate
                py.test --junit-xml test-reports/results.xml sources/test_calc.py
                '''
            }
            post {
                always {
                    // Публикация результатов тестов в интерфейсе Jenkins
                    junit 'test-reports/results.xml'
                }
            }
        }

        stage('Deliver') {
            steps {
                echo 'Собираю дистрибутив'
                unstash(name: 'compiled-results')
                // Проверяем, что собранное приложение работает
                sh 'python sources/add2vals.py 15 20'
            }
            post {
                success {
                    // Архивируем файлы только при успешном завершении этапа
                    // venv исключаем, чтобы не архивировать файлы pip
                    archiveArtifacts artifacts: '**/*.py', excludes: 'venv/**'
                }
            }
        }
    }
}
